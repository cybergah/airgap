{
  "name": "kod-ajani",
  "displayName": "Airgap",
  "description": "Security-hardened AI coding agent that runs 100% locally with Ollama",
  "version": "0.11.0",
  "publisher": "cybergah",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onView:kodAjani.panel", "onCommand:kodAjani.seciliDuzenle", "onCommand:kodAjani.yeni"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "kodAjani", "title": "Airgap", "icon": "media/ikon.svg" }
      ]
    },
    "views": {
      "kodAjani": [
        { "id": "kodAjani.panel", "name": "Chat", "type": "webview" }
      ]
    },
    "commands": [
      { "command": "kodAjani.yeni", "title": "New chat", "category": "Airgap", "icon": "$(add)" },
      { "command": "kodAjani.seciliDuzenle", "title": "Edit selection", "category": "Airgap" }
    ],
    "keybindings": [
      { "command": "kodAjani.seciliDuzenle", "key": "ctrl+alt+k", "mac": "cmd+alt+k", "when": "editorTextFocus && !editorReadonly" }
    ],
    "menus": {
      "editor/context": [
        { "command": "kodAjani.seciliDuzenle", "when": "editorTextFocus && !editorReadonly", "group": "1_modification" }
      ],
      "view/title": [
        { "command": "kodAjani.yeni", "when": "view == kodAjani.panel", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Airgap",
      "properties": {
        "kodAjani.dil": {
          "type": "string",
          "enum": ["en", "tr"],
          "enumDescriptions": ["English", "Türkçe"],
          "default": "en",
          "description": "Interface language. Text sent to the model is not affected."
        },
        "kodAjani.model": {
          "type": "string",
          "default": "gpt-oss:20b",
          "description": "Ollama model to use."
        },
        "kodAjani.gommeModeli": {
          "type": "string",
          "default": "nomic-embed-text",
          "description": "Ollama embedding model used for project search."
        },
        "kodAjani.haritaButcesi": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "Approximate token budget for the repo map given to the model. 0 turns the map off."
        },
        "kodAjani.korumaliCalistirma": {
          "type": "boolean",
          "default": false,
          "description": "Run commands in a Docker container with no network. If Docker is not running, commands are rejected instead of running on your computer."
        },
        "kodAjani.korumaliImaj": {
          "type": "string",
          "default": "python:3.13-slim",
          "description": "Docker image for the sandbox. It is not downloaded automatically; run docker pull first."
        },
        "kodAjani.python": {
          "type": "string",
          "default": "python",
          "description": "Python command used to run the agent."
        },
        "kodAjani.ajanYolu": {
          "type": "string",
          "default": "",
          "description": "Full path to ajan.py. Leave empty to use the one bundled with the extension."
        },
        "kodAjani.baglam": {
          "type": "number",
          "default": 16384,
          "description": "Model context size (num_ctx)."
        },
        "kodAjani.maksAdim": {
          "type": "number",
          "default": 40,
          "description": "Maximum model calls per request."
        }
      }
    }
  }
}
